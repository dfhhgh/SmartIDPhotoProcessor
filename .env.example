# Dataset Builder API Keys
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.

PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Wikimedia Commons requires a descriptive User-Agent with real contact info.
# See: https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy
# Format: <client name>/<version> (<contact information>)
# WIKIMEDIA_USER_AGENT=SmartIDPhotoProcessorDatasetBuilder/1.0 (https://github.com/anomalyco/SmartIDPhotoProcessor; Educational Research Dataset Builder)
